# Copy this file to .env (and load it, or export the vars) before running the app.

# Required for the NL-to-SQL layer (app/nl_to_sql.py, app/streamlit_app.py)
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: pin a specific Gemini model instead of the rolling "latest" alias
# GEMINI_MODEL=gemini-3.1-flash-lite

# Optional: only needed if you run data/fetch_tmdb_data.py for real data
TMDB_API_KEY=your_tmdb_api_key_here
